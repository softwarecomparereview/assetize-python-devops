#!/usr/bin/env bash
# Assetize fork-only pre-push hook.
#
# Blocks pushing AI-agent files (AGENTS.md, CLAUDE.md, .claude/, ...) and other
# fork-only files to any remote that is not an Assetize fork (e.g. ibm-mas/*).
# See the "never contribute AI-agent files upstream" rule in AGENTS.md.
# Install with: .assetize/install-hooks.sh
#
# Remotes whose URL matches ASSETIZE_FORK_PATTERN (extended regex, matched against the
# whole URL) are allowed. The default accepts only github.com HTTPS / SSH URLs of the forks.

remote_name="$1"
remote_url="$2"
fork_pattern="${ASSETIZE_FORK_PATTERN:-^(https://([^@/]+@)?github\.com/|ssh://git@github\.com/|git@github\.com:)(softwarecomparereview/[^/]+|paananiruddh/assetize-[^/]+)$}"

if [[ "$remote_url" =~ $fork_pattern ]]; then
  exit 0
fi

# Paths that must never reach an upstream repository
forbidden='(^|/)(AGENTS\.md|CLAUDE\.md|CLAUDE\.local\.md|GEMINI\.md)$'
forbidden+='|(^|/)(\.claude|\.assetize)/'
# Any file or directory named .cursor*, .windsurf* or .aider* (e.g. .cursorrules, .cursorignore, .windsurf/)
forbidden+='|(^|/)\.(cursor|windsurf|aider)[^/]*(/|$)'
forbidden+='|^\.github/copilot-instructions\.md$'
# Assetize fork-only tooling (image build, workflows)
forbidden+='|^assetize/|^\.github/workflows/assetize-'

violations=""

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch/tag deletion: nothing is being sent
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi

  # Files present in the tree being pushed
  files=$(git ls-tree -r --name-only "$local_sha")

  # Files touched by any commit not yet on this remote (catches add-then-remove)
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    range=$(git rev-list "$local_sha" --not --remotes="$remote_name" 2>/dev/null)
  else
    range=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
  fi
  for commit in $range; do
    files+=$'\n'$(git diff-tree --no-commit-id --name-only -r --root "$commit")
  done

  hits=$(printf '%s\n' "$files" | grep -E "$forbidden" | sort -u)
  if [[ -n "$hits" ]]; then
    violations+="  ${local_ref} -> ${remote_ref}:"$'\n'
    violations+=$(printf '%s\n' "$hits" | sed 's/^/    /')$'\n'
  fi
done

if [[ -n "$violations" ]]; then
  echo "" >&2
  echo "pre-push BLOCKED: AI-agent / fork-only files would be pushed to a non-Assetize remote." >&2
  echo "Remote: ${remote_name} (${remote_url})" >&2
  echo "" >&2
  printf '%s' "$violations" >&2
  echo "" >&2
  echo "These files must never be contributed upstream (see the AI-agent files rule in AGENTS.md)." >&2
  echo "Branch from upstream master and cherry-pick only the code change instead." >&2
  exit 1
fi

exit 0
